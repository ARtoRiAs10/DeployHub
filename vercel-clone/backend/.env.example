# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://deployhub:deployhub123@localhost:5432/deployhub"

# Redis (for Bull queue)
REDIS_URL=redis://localhost:6379

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET_NAME=your-deployhub-bucket

# Public URL for serving deployments
DEPLOYMENT_BASE_URL=https://your-bucket.s3-website.us-east-1.amazonaws.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Docker
DOCKER_SOCKET=/var/run/docker.sock
BUILD_TIMEOUT_MS=300000
