# =============================================================================
# DeployHub Frontend — Environment Variables
# =============================================================================
# SETUP:
#   cp .env.local.example .env.local
#   Fill in each value. NEVER commit .env.local to git.
#
# All NEXT_PUBLIC_ variables are exposed to the browser.
# Variables WITHOUT the prefix are server-side only (API routes, middleware).
# =============================================================================


# ── Authentication (Clerk) ────────────────────────────────────────────────────
# REQUIRED. Get from: https://dashboard.clerk.com → Your App → API Keys
#
# PUBLISHABLE key: safe to expose in browser (prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_PUBLISHABLE_KEY

# SECRET key: server-side only (middleware, API routes). Never expose to browser.
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_SECRET_KEY


# ── Backend API URL ────────────────────────────────────────────────────────────
# REQUIRED. Where the frontend sends API requests.
#
# Local development:  http://localhost:4000
# Production (nginx): https://yourdomain.com  (nginx proxies /api/ to backend)
# Production (split): https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:4000
