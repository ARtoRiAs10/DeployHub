# =============================================================================
# DeployHub Backend — Environment Variables
# =============================================================================
# SETUP:
#   cp .env.example .env
#   Fill in each value below. NEVER commit .env to git.
#
# REQUIRED variables must all be set or the server will refuse to start.
# OPTIONAL variables have defaults shown; leave blank to use the default.
# =============================================================================


# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development             # development | production | test
FRONTEND_URL=http://localhost:3000  # Must match your Next.js dev server or prod domain


# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# REQUIRED. Run `docker-compose up -d postgres` for local dev.
DATABASE_URL="postgresql://deployhub:deployhub123@localhost:5432/deployhub"


# ── Cache / Queue (Redis) ────────────────────────────────────────────────────
# REQUIRED. Run `docker-compose up -d redis` for local dev.
REDIS_URL=redis://localhost:6379


# ── Authentication (Clerk) ───────────────────────────────────────────────────
# REQUIRED. Get from: https://dashboard.clerk.com → Your App → API Keys
# The SECRET key is backend-only. The PUBLISHABLE key goes in the frontend .env.
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_CLERK_SECRET_KEY


# ── AWS Credentials ───────────────────────────────────────────────────────────
# REQUIRED. Create an IAM user with these policies:
#   - AmazonS3FullAccess (or scoped to your bucket)
#   - AmazonEC2ContainerRegistryFullAccess
#   - AmazonSSMFullAccess
#   - AmazonEC2ReadOnlyAccess
# Guide: https://docs.aws.amazon.com/IAM/latest/UserGuide/id_users_create.html
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=REPLACE_WITH_YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_YOUR_SECRET_ACCESS_KEY


# ── S3 — Static Frontend Deployments ─────────────────────────────────────────
# REQUIRED. Create an S3 bucket and enable static website hosting.
# Guide: https://docs.aws.amazon.com/AmazonS3/latest/userguide/WebsiteHosting.html
S3_BUCKET_NAME=your-deployhub-bucket-name

# OPTIONAL. Override the deployment URL (e.g. use a CloudFront domain instead of S3).
# Default: http://<S3_BUCKET_NAME>.s3-website.<AWS_REGION>.amazonaws.com
# DEPLOYMENT_BASE_URL=https://d1234abcd.cloudfront.net


# ── EC2 — Backend / SSR Deployments ──────────────────────────────────────────
# REQUIRED. The EC2 instance where backend containers are deployed via SSM.
# The instance must have:
#   - SSM Agent installed and running
#   - IAM role with AmazonEC2RoleforSSM policy
#   - Docker installed
#   - ECR login configured (aws ecr get-login-password ...)
# Guide: https://docs.aws.amazon.com/systems-manager/latest/userguide/ssm-agent.html
EC2_INSTANCE_ID=i-REPLACE_WITH_YOUR_INSTANCE_ID
EC2_PUBLIC_DNS=ec2-REPLACE.compute-1.amazonaws.com


# ── AI / LLM Fallback (Optional) ─────────────────────────────────────────────
# OPTIONAL. If set, enables AI-based framework detection for unknown repos.
# Get a free key from: https://openrouter.ai/keys
# Leave blank to disable AI detection (curated + pattern detection still works).
# OPENROUTER_API_KEY=sk-or-REPLACE_WITH_YOUR_KEY
# OPENROUTER_MODEL=meta-llama/llama-3.3-8b-instruct:free


# ── Docker ────────────────────────────────────────────────────────────────────
# OPTIONAL. Path to Docker socket. Default: /var/run/docker.sock
# DOCKER_SOCKET=/var/run/docker.sock


# ── Logging ───────────────────────────────────────────────────────────────────
# OPTIONAL. error | warn | info | debug
# LOG_LEVEL=info


# ── Build Timeouts ────────────────────────────────────────────────────────────
# OPTIONAL. Max time for Docker build in milliseconds. Default: 5 minutes.
# BUILD_TIMEOUT_MS=300000


# ── EC2 Port Allocation ───────────────────────────────────────────────────────
# Range of HOST-side ports DeployHub may assign to backend containers.
# Each project gets one unique port in this range (stable across re-deploys).
# Ensure your EC2 security group allows inbound traffic on this port range.
# Default: 3100–3999 (900 possible concurrent backend projects).
# EC2_PORT_RANGE_START=3100
# EC2_PORT_RANGE_END=3999
